VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Owner's Supabase Auth user id (uuid) — set after bootstrapping the owner
# account (see supabase/README.md). Only used to gate Dashboard.jsx's
# one-time notification-rule setup.
VITE_APP_OWNER_ID=

# Show the owner's email/password sign-in button on the login screen (default: hidden).
VITE_SHOW_OWNER_LOGIN=false

# Optional: sub-path the app is served from (default '/').
VITE_BASE=/
